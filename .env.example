NODE_ENV=development
PORT=3000

# Local MongoDB. In production use a MongoDB Atlas connection string, e.g.
# mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/online_survey_system?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/online_survey_system

SESSION_SECRET=replace_this_with_a_long_random_string

# Used only by "npm run seed" to create the demo admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password
