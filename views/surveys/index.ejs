<% const statusStyles = { draft: 'secondary', published: 'success', closed: 'dark' }; %>
<div class="container page-section">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="section-title mb-0">My Surveys</h1>
    <a href="/surveys/new" class="btn btn-primary"><i class="fa-solid fa-plus"></i> New Survey</a>
  </div>

  <% if (surveys.length === 0) { %>
    <div class="empty-state">
      <i class="fa-solid fa-clipboard-list empty-icon"></i>
      <p>You have not created any surveys yet.</p>
      <a href="/surveys/new" class="btn btn-primary">Create your first survey</a>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle bg-white">
        <thead>
          <tr>
            <th>Title</th>
            <th>Questions</th>
            <th>Status</th>
            <th>Created</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% surveys.forEach(function (survey) { %>
            <tr>
              <td><a href="/surveys/<%= survey._id %>"><%= survey.title %></a></td>
              <td><%= survey.questions.length %></td>
              <td><span class="badge bg-<%= statusStyles[survey.status] %>"><%= survey.status %></span></td>
              <td><%= survey.createdAt.toLocaleDateString() %></td>
              <td class="text-end">
                <a href="/surveys/<%= survey._id %>" class="btn btn-sm btn-outline-secondary" title="View">
                  <i class="fa-solid fa-eye"></i>
                </a>
                <a href="/surveys/<%= survey._id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit">
                  <i class="fa-solid fa-pen"></i>
                </a>
                <form action="/surveys/<%= survey._id %>?_method=DELETE" method="POST" class="d-inline"
                      onsubmit="return confirm('Delete this survey and all of its questions?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
