<div class="container page-section">
  <a href="/surveys/<%= survey._id %>" class="back-link"><i class="fa-solid fa-arrow-left"></i> Back to survey</a>

  <div class="mt-3 mb-4">
    <h1 class="section-title mb-2">Results: <%= survey.title %></h1>
    <%- include('../partials/statusBadge', { status: survey.status }) %>
    <span class="badge bg-primary"><%= results.totalResponses %> responses</span>
  </div>

  <% if (results.totalResponses === 0) { %>
    <div class="empty-state">
      <i class="fa-solid fa-chart-simple empty-icon"></i>
      <p>No responses have been collected yet.</p>
      <% if (survey.status === 'published') { %>
        <p class="mb-0">Share the public link to start gathering answers.</p>
      <% } %>
    </div>
  <% } else { %>
    <div id="resultsCharts" data-results="<%= JSON.stringify(chartData) %>">
      <% results.questions.forEach(function (question, index) { %>
        <div class="question-card">
          <h6 class="mb-2"><%= index + 1 %>. <%= question.text %></h6>
          <span class="badge bg-light text-dark border"><%= questionTypeLabels[question.type] %></span>
          <span class="badge bg-light text-dark border"><%= question.answered %> of <%= results.totalResponses %> answered</span>

          <% if (question.type === 'rating') { %>
            <span class="badge bg-info text-dark">Average <%= question.average %></span>
          <% } %>

          <% if (question.counts) { %>
            <div class="row align-items-center mt-3">
              <div class="col-md-7">
                <% question.counts.forEach(function (entry) { %>
                  <div class="result-row">
                    <div class="d-flex justify-content-between">
                      <span><%= entry.label %></span>
                      <span class="text-muted"><%= entry.count %> (<%= entry.percentage %>%)</span>
                    </div>
                    <div class="progress">
                      <div class="progress-bar" style="width: <%= entry.percentage %>%"></div>
                    </div>
                  </div>
                <% }); %>
              </div>
              <div class="col-md-5">
                <div class="chart-holder">
                  <canvas id="chart-<%= question.id %>"></canvas>
                </div>
              </div>
            </div>
          <% } else { %>
            <% if (question.texts.length === 0) { %>
              <p class="text-muted mt-3 mb-0">Nobody answered this question.</p>
            <% } else { %>
              <ul class="text-answer-list">
                <% question.texts.forEach(function (text) { %>
                  <li><%= text %></li>
                <% }); %>
              </ul>
            <% } %>
          <% } %>
        </div>
      <% }); %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="/js/results.js"></script>
  <% } %>
</div>
