<div class="container page-section">
  <a href="/surveys" class="back-link"><i class="fa-solid fa-arrow-left"></i> Back to my surveys</a>

  <div class="d-flex justify-content-between align-items-start mt-3 mb-4">
    <div>
      <h1 class="section-title mb-2"><%= survey.title %></h1>
      <%- include('../partials/statusBadge', { status: survey.status }) %>
      <% if (survey.description) { %>
        <p class="text-muted mt-2 mb-0"><%= survey.description %></p>
      <% } %>
    </div>
    <div class="text-nowrap">
      <% if (survey.status === 'draft') { %>
        <form action="/surveys/<%= survey._id %>/publish?_method=PUT" method="POST" class="d-inline">
          <button type="submit" class="btn btn-success">
            <i class="fa-solid fa-paper-plane"></i> Publish
          </button>
        </form>
      <% } else if (survey.status === 'published') { %>
        <form action="/surveys/<%= survey._id %>/close?_method=PUT" method="POST" class="d-inline">
          <button type="submit" class="btn btn-outline-dark">
            <i class="fa-solid fa-lock"></i> Close
          </button>
        </form>
      <% } else { %>
        <form action="/surveys/<%= survey._id %>/reopen?_method=PUT" method="POST" class="d-inline">
          <button type="submit" class="btn btn-outline-success">
            <i class="fa-solid fa-lock-open"></i> Reopen
          </button>
        </form>
      <% } %>
      <% if (survey.status !== 'draft') { %>
        <a href="/surveys/<%= survey._id %>/results" class="btn btn-outline-info">
          <i class="fa-solid fa-chart-simple"></i> Results
        </a>
      <% } %>
      <a href="/surveys/<%= survey._id %>/edit" class="btn btn-outline-primary">
        <i class="fa-solid fa-pen"></i> Edit
      </a>
      <form action="/surveys/<%= survey._id %>?_method=DELETE" method="POST" class="d-inline"
            onsubmit="return confirm('Delete this survey and all of its questions?');">
        <button type="submit" class="btn btn-outline-danger">
          <i class="fa-solid fa-trash"></i> Delete
        </button>
      </form>
    </div>
  </div>

  <% if (shareUrl) { %>
    <div class="share-box">
      <label for="shareLink" class="form-label mb-1"><i class="fa-solid fa-link"></i> Public survey link</label>
      <div class="input-group">
        <input type="text" class="form-control" id="shareLink" value="<%= shareUrl %>" readonly>
        <button type="button" class="btn btn-outline-secondary" id="copyShareLink">
          <i class="fa-solid fa-copy"></i> Copy
        </button>
      </div>
      <% if (survey.status === 'closed') { %>
        <div class="form-text">This survey is closed, so the link no longer accepts new responses.</div>
      <% } %>
    </div>
    <script src="/js/share.js"></script>
  <% } %>

  <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h4 class="mb-0">Questions (<%= survey.questions.length %>)</h4>
    <% if (survey.status === 'draft') { %>
      <a href="/surveys/<%= survey._id %>/questions/new" class="btn btn-primary">
        <i class="fa-solid fa-plus"></i> Add Question
      </a>
    <% } %>
  </div>

  <% if (survey.status !== 'draft') { %>
    <div class="alert alert-info">
      <i class="fa-solid fa-circle-info"></i>
      Questions are locked once a survey leaves draft, so existing responses stay meaningful.
    </div>
  <% } %>

  <% if (survey.questions.length === 0) { %>
    <div class="empty-state">
      <i class="fa-solid fa-circle-question empty-icon"></i>
      <p>This survey has no questions yet.</p>
    </div>
  <% } else { %>
    <% survey.questions.forEach(function (question, index) { %>
      <div class="question-card">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <h6 class="mb-2"><%= index + 1 %>. <%= question.text %></h6>
            <span class="badge bg-light text-dark border"><%= questionTypeLabels[question.type] %></span>
            <% if (question.required) { %>
              <span class="badge bg-warning text-dark">Required</span>
            <% } %>
          </div>
          <% if (survey.status === 'draft') { %>
            <div class="text-nowrap">
              <form action="/surveys/<%= survey._id %>/questions/<%= question._id %>/move?_method=PUT" method="POST" class="d-inline">
                <input type="hidden" name="direction" value="up">
                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Move up" <%= index === 0 ? 'disabled' : '' %>>
                  <i class="fa-solid fa-arrow-up"></i>
                </button>
              </form>
              <form action="/surveys/<%= survey._id %>/questions/<%= question._id %>/move?_method=PUT" method="POST" class="d-inline">
                <input type="hidden" name="direction" value="down">
                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Move down" <%= index === survey.questions.length - 1 ? 'disabled' : '' %>>
                  <i class="fa-solid fa-arrow-down"></i>
                </button>
              </form>
              <a href="/surveys/<%= survey._id %>/questions/<%= question._id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit">
                <i class="fa-solid fa-pen"></i>
              </a>
              <form action="/surveys/<%= survey._id %>/questions/<%= question._id %>?_method=DELETE" method="POST" class="d-inline"
                    onsubmit="return confirm('Remove this question?');">
                <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </form>
            </div>
          <% } %>
        </div>

        <% if (question.options.length > 0) { %>
          <ul class="option-list">
            <% question.options.forEach(function (option) { %>
              <li><%= option %></li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    <% }); %>
  <% } %>
</div>
