<% const flashGroups = [
  { style: 'success', icon: 'fa-circle-check', messages: success },
  { style: 'danger', icon: 'fa-circle-exclamation', messages: error }
]; %>
<% flashGroups.forEach(function (group) { %>
  <% group.messages.forEach(function (message) { %>
    <div class="alert alert-<%= group.style %> alert-dismissible fade show" role="alert">
      <i class="fa-solid <%= group.icon %>"></i> <%= message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }); %>
<% }); %>
