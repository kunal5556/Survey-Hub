<div class="container page-section">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="form-card">
        <h1 class="section-title mb-2"><%= survey.title %></h1>
        <% if (survey.description) { %>
          <p class="text-muted"><%= survey.description %></p>
        <% } %>

        <% if (survey.status === 'closed') { %>
          <div class="alert alert-dark mt-3">
            <i class="fa-solid fa-lock"></i>
            This survey has been closed and is no longer accepting responses.
          </div>
        <% } else { %>
          <form action="/s/<%= survey.shareSlug %>" method="POST">
            <% survey.questions.forEach(function (question, index) { %>
              <div class="respond-question">
                <p class="respond-question-text">
                  <%= index + 1 %>. <%= question.text %>
                  <% if (question.required) { %><span class="text-danger">*</span><% } %>
                </p>

                <% if (question.type === 'single-choice') { %>
                  <% question.options.forEach(function (option, optionIndex) { %>
                    <div class="form-check">
                      <input class="form-check-input" type="radio"
                             name="answers[<%= question._id %>]"
                             id="q<%= index %>o<%= optionIndex %>"
                             value="<%= option %>"
                             <%= question.required ? 'required' : '' %>>
                      <label class="form-check-label" for="q<%= index %>o<%= optionIndex %>"><%= option %></label>
                    </div>
                  <% }); %>

                <% } else if (question.type === 'multiple-choice') { %>
                  <% question.options.forEach(function (option, optionIndex) { %>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox"
                             name="answers[<%= question._id %>]"
                             id="q<%= index %>o<%= optionIndex %>"
                             value="<%= option %>">
                      <label class="form-check-label" for="q<%= index %>o<%= optionIndex %>"><%= option %></label>
                    </div>
                  <% }); %>

                <% } else if (question.type === 'rating') { %>
                  <div class="rating-group">
                    <% ratingScale.forEach(function (rating) { %>
                      <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio"
                               name="answers[<%= question._id %>]"
                               id="q<%= index %>r<%= rating %>"
                               value="<%= rating %>"
                               <%= question.required ? 'required' : '' %>>
                        <label class="form-check-label" for="q<%= index %>r<%= rating %>"><%= rating %></label>
                      </div>
                    <% }); %>
                  </div>

                <% } else { %>
                  <textarea class="form-control" rows="3"
                            name="answers[<%= question._id %>]"
                            <%= question.required ? 'required' : '' %>></textarea>
                <% } %>
              </div>
            <% }); %>

            <button type="submit" class="btn btn-primary">
              <i class="fa-solid fa-paper-plane"></i> Submit Response
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</div>
